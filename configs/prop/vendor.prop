# Audio hardware
ro.hardware.audio.primary=cepheus

# Fingerprint
persist.vendor.fingerprint.sensor_location=542|2007|87
persist.vendor.fingerprint.type=udfps_optical
persist.vendor.fingerprint.udfps.control_illumination=true

# Sensors
ro.vendor.sensors.xiaomi.udfps=true

# Infinity X
ro.product.marketname=Mi 9
ro.infinity.soc=Snapdragon 855
ro.infinity.camera=48MP + 12MP + 16MP

# Hack
debug.hwui.renderer=skiavk
debug.renderengine.vulkan=true
debug.renderengine.backend=skiavkthreaded
debuf.stagefright.renderengine.backend=threaded
